{
  "version": 2,
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/next" },
    {
      "src": "src/api/main.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["config/**", "templates/**"] }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "src/api/main.py" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}
