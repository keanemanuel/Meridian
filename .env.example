# Copy this file to .env and fill in real values. Never commit .env.

# Google service account used to read the applicant Sheet and to write the
# exported timetable Sheet.
#
# Two APIs must be enabled on the service account's Google Cloud project:
#   - Google Sheets API  — reading the form responses, writing the timetable
#   - Google Drive API   — creating the exported Sheet and sharing it by link
# With only Sheets enabled, ingest works and `Export` fails with a 403.
#
# On a host with no file upload (Railway, Vercel), paste the key JSON itself
# as this value and it is written to a file at startup. Paste it exactly
# once: two copies of the same key are tolerated with a warning, but two
# *different* keys are refused rather than guessed between.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
GOOGLE_SHEETS_SPREADSHEET_ID=

# Drive folder the exported timetable Sheet is created inside. A service
# account has no personal Drive storage of its own, so leaving this unset
# ("current behaviour": create in the service account's own Drive root)
# fails every export with storageQuotaExceeded — that's a platform limit,
# not something that gets fixed by clearing space.
#
# The folder must be inside a *Shared Drive*, with the service account added
# to that Shared Drive as a member (Content Manager or above). An ordinary
# "My Drive" folder shared with the service account as Editor does NOT work:
# Drive bills a file's storage to whoever created it, not to the folder it
# sits in, so the service account's zero quota still applies. Shared Drives
# need a Google Workspace plan — see docs/DEPLOY.md, "Google Drive export
# storage" for the one-time setup and why a personal Google account can't do
# this at all.
GOOGLE_DRIVE_FOLDER_ID=

# Gmail API sending: OAuth2 installed-app flow against the operator's own
# Gmail account (see docs/RUNBOOK.md, "One-time OAuth2 setup"). The first
# `notify ... --send` opens a browser for one-time consent and caches the
# token at GMAIL_TOKEN_CACHE; every run after that is silent.
GMAIL_OAUTH_CREDENTIALS=credentials/gmail_oauth.json
GMAIL_TOKEN_CACHE=credentials/gmail_token.json
GMAIL_SENDER_EMAIL=

# Alternative: transactional email provider (used instead of Gmail).
RESEND_API_KEY=

# Runtime environment name, surfaced in logs and run artefacts.
IFF_SCHEDULER_ENV=development

# Frontend → backend URL. Unset locally (the Next.js dev server proxies
# /api/* to uvicorn on :8000). In production this is set in the Vercel
# project to the Railway API's public URL, e.g.
# https://meridian-api-production.up.railway.app  (see docs/DEPLOY.md).
NEXT_PUBLIC_API_URL=

# Beta: Supabase Postgres store (SPEC.md §14). Leave BOTH unset to keep the
# alpha CSV/YAML file store — the CLI never needs these and always runs
# file-mode. Set both and the API reads/writes workspaces, runs, assignments
# and the send ledger from Postgres instead.
SUPABASE_URL=your-project-url
SUPABASE_KEY=your-anon-key
