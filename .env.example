# Copy this file to .env and fill in real values. Never commit .env.

# Google service account used to read the applicant Sheet.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
GOOGLE_SHEETS_SPREADSHEET_ID=

# Gmail API sending: OAuth2 installed-app flow against the operator's own
# Gmail account (see docs/RUNBOOK.md, "One-time OAuth2 setup"). The first
# `notify ... --send` opens a browser for one-time consent and caches the
# token at GMAIL_TOKEN_CACHE; every run after that is silent.
GMAIL_OAUTH_CREDENTIALS=credentials/gmail_oauth.json
GMAIL_TOKEN_CACHE=credentials/gmail_token.json
GMAIL_SENDER_EMAIL=

# Alternative: transactional email provider (used instead of Gmail).
RESEND_API_KEY=

# Runtime environment name, surfaced in logs and run artefacts.
IFF_SCHEDULER_ENV=development

# Beta: Supabase Postgres store (SPEC.md §14). Leave BOTH unset to keep the
# alpha CSV/YAML file store — the CLI never needs these and always runs
# file-mode. Set both and the API reads/writes workspaces, runs, assignments
# and the send ledger from Postgres instead.
SUPABASE_URL=your-project-url
SUPABASE_KEY=your-anon-key
