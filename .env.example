# Copy this file to .env and fill in real values. Never commit .env.

# Google service account used to read the applicant Sheet and, optionally,
# send via the Gmail API (see config/notify.yaml for the sending method).
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
GOOGLE_SHEETS_SPREADSHEET_ID=

# Gmail API sender, if using domain-wide delegation instead of OAuth.
GMAIL_SENDER_EMAIL=

# Alternative: transactional email provider (used instead of Gmail).
RESEND_API_KEY=

# Runtime environment name, surfaced in logs and run artefacts.
IFF_SCHEDULER_ENV=development
