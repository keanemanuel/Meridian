# Secrets and PII — never committed.
# Anchored with a leading slash so these match only the repo-root directories
# they mean. An unanchored `runs/` also matched
# `frontend/app/workspace/[id]/runs/`, which silently kept the entire run
# detail route out of the repository — and so out of every deployed build,
# where the page then 404'd.
/data/
/runs/
/credentials/
# Every .env variant (.env, .env.local — which the Vercel CLI writes a
# VERCEL_OIDC_TOKEN into, .env.production, ...) except the checked-in template.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.venv/
venv/
build/
dist/

# Node / Next.js
node_modules/
.next/
next-env.d.ts
tsconfig.tsbuildinfo
.vercel

# OS / editor
.DS_Store
.Rhistory
.vscode/

# Overnight autonomous run scaffolding — not part of the app, don't commit
overnight_prompts/
.overnight_state/
overnight_log_*.txt
run_overnight.sh

